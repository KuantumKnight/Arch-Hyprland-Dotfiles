@theme "base.rasi"
* { font: "Noto Color Emoji 26"; }
inputbar { font: "JetBrainsMono Nerd Font 12"; }
entry, prompt { font: "JetBrainsMono Nerd Font 12"; }
window { width: 660px; }
listview { columns: 8; lines: 5; spacing: 8px; dynamic: false; }
element { padding: 12px; }
element-text { font: "Noto Color Emoji 26"; horizontal-align: 0.5; }
entry { placeholder: "Search emoji…"; }
