[Unit]
Description=Wallpaper backend and selected image or video restoration
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.config/viegphunt/wallpaper-backend.sh
ExecStartPost=/usr/bin/bash -c 'IFS= read -r wallpaper < "%h/.config/hypr/wallpaper" || exit 0; [[ -f "$wallpaper" ]] || exit 0; exec "%h/.config/viegphunt/set-wallpaper.sh" "$wallpaper" --restore'
Restart=on-failure
RestartSec=3
TimeoutStopSec=3
