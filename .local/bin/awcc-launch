#!/usr/bin/env python3
"""Open or focus the optional themed Alienware Command Center GUI."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess

home = Path.home()
launcher = home / ".local/bin/awcc-caelestia"

def focus_existing():
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return False
    result = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True)
    try:
        windows = json.loads(result.stdout)
    except ValueError:
        return False
    window = next((item for item in windows if item.get("class") == "awcc"), None)
    if not window:
        return False
    address = "address:" + window["address"]
    workspace = json.loads(subprocess.check_output(["hyprctl", "-j", "activeworkspace"]))["id"]
    subprocess.run(["hyprctl", "dispatch", "hl.dsp.window.move({window=" + json.dumps(address) + ",workspace=" + str(workspace) + ",follow=false})"], check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["hyprctl", "dispatch", "hl.dsp.focus({window=" + json.dumps(address) + "})"], check=True, stdout=subprocess.DEVNULL)
    return True

if not focus_existing():
    if not launcher.is_file() or not os.access(launcher, os.X_OK):
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "Optional AWCC integration", "Install your AWCC GUI at ~/.local/bin/awcc-caelestia to enable this button."])
        raise SystemExit(0)
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    with (runtime / "awcc-caelestia-launch.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit(0)
        if not focus_existing():
            log = home / ".local/state/awcc-caelestia/gui.log"
            log.parent.mkdir(parents=True, exist_ok=True)
            with log.open("a") as output:
                subprocess.run([str(launcher), "--gui"], stdout=output, stderr=output, check=True)
